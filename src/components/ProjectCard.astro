---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card" style={`--accent-a: ${project.accent}`}>
  <div class="card-top">
    <a href={project.repo} target="_blank" rel="noopener noreferrer" class="repo-link">
      <span class="lang-dot" style={`background: ${project.accent}`}></span>{project.name}
    </a>
    <span style="color: var(--muted)">↗</span>
  </div>
  <p class="description">{project.description}</p>
  <ul>
    {project.highlights.map((h) => <li>{h}</li>)}
  </ul>
  <div class="tags">
    {project.stack.map((s) => <span class="tag">{s}</span>)}
  </div>
</article>
