---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;

const updated = project.pushedAt
  ? new Date(project.pushedAt).toLocaleDateString("es-CL", {
      year: "numeric",
      month: "short",
    })
  : null;
---

<article class="project-card" data-reveal style={`--accent-a: ${project.accent}; --delay: ${(index % 3) * 90}ms;`}>
  <div class="card-top">
    <a href={project.repo} target="_blank" rel="noopener noreferrer" class="repo-link">
      <span class="lang-dot" style={`background: ${project.accent}`}></span>{project.name}
    </a>
    <span class="card-arrow">↗</span>
  </div>
  <p class="description">{project.description}</p>
  {project.award && <p class="award">{project.award}</p>}
  {project.highlights.length > 0 && (
    <ul>
      {project.highlights.map((h) => <li>{h}</li>)}
    </ul>
  )}
  <div class="tags">
    {project.stack.map((s) => <span class="tag">{s}</span>)}
  </div>
  <div class="card-meta">
    <span>{project.language}</span>
    {updated && <span>Actualizado {updated}</span>}
  </div>
</article>
